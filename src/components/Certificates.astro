---
---

<section id="certificates" class="section-padding">
    <div class="container">
        <div class="section-header">
            <span class="section-number text-reveal">03.</span>
            <h2 class="section-title text-reveal">
                <span class="glitch" data-text="Certifications">Certifications</span>
            </h2>
        </div>

        <div class="certificates-grid">
            <!-- Full Stack -->
            <div class="cert-card text-reveal magnetic">
                <div class="cert-image-container">
                    <img src="/certificates/fullstack.png" alt="Full Stack Mastery" class="cert-image">
                    <div class="cert-overlay">
                         <div class="cert-icon">
                            <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                            </svg>
                        </div>
                    </div>
                </div>
                <div class="cert-card-info">
                    <div class="cert-content">
                        <h3 class="cert-title">Full Stack Development</h3>
                        <p class="cert-issuer">Digital Education</p>
                        <p class="cert-date">Advanced Credentials</p>
                        <div class="cert-links">
                            <a href="/files/fullstack.pdf" class="cert-link" target="_blank">
                                <span>View PDF </span>
                                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7zM19 19H5V5h7V3H5c-1.11 0-2 .89-2 2v14c0 1.11.89 2 2 2h14c1.11 0 2-.89 2-2v-7h-2v7z"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Frameworks JS -->
            <div class="cert-card text-reveal magnetic">
                <div class="cert-image-container">
                    <img src="/certificates/frameworks.png" alt="Modern Frameworks" class="cert-image">
                    <div class="cert-overlay">
                         <div class="cert-icon">
                            <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                            </svg>
                        </div>
                    </div>
                </div>
                <div class="cert-card-info">
                    <div class="cert-content">
                        <h3 class="cert-title">Modern JS Frameworks</h3>
                        <p class="cert-issuer">Angular, Vue </p>
                        <p class="cert-date">Issued: 2025</p>
                        <div class="cert-links">
                            <a href="/files/frameworksjs.pdf" class="cert-link" target="_blank">
                                <span>View PDF</span>
                                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7zM19 19H5V5h7V3H5c-1.11 0-2 .89-2 2v14c0 1.11.89 2 2 2h14c1.11 0 2-.89 2-2v-7h-2v7z"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PHP -->
            <div class="cert-card text-reveal magnetic">
                <div class="cert-image-container">
                    <img src="/certificates/php.png" alt="Backend Development" class="cert-image">
                    <div class="cert-overlay">
                         <div class="cert-icon">
                            <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                            </svg>
                        </div>
                    </div>
                </div>
                <div class="cert-card-info">
                    <div class="cert-content">
                        <h3 class="cert-title">Backend Development</h3>
                        <p class="cert-issuer">PHP & Laravel</p>
                        <p class="cert-date">Issued: 2024</p>
                        <div class="cert-links">
                            <a href="/files/php.pdf" class="cert-link" target="_blank">
                                <span>View PDF</span>
                                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7zM19 19H5V5h7V3H5c-1.11 0-2 .89-2 2v14c0 1.11.89 2 2 2h14c1.11 0 2-.89 2-2v-7h-2v7z"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- GitHub -->
            <div class="cert-card text-reveal magnetic">
                <div class="cert-image-container">
                    <img src="/certificates/github.png" alt="Git & GitHub Mastery" class="cert-image">
                    <div class="cert-overlay">
                         <div class="cert-icon">
                            <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                            </svg>
                        </div>
                    </div>
                </div>
                <div class="cert-card-info">
                    <div class="cert-content">
                        <h3 class="cert-title">Version Control</h3>
                        <p class="cert-issuer">Git & GitHub</p>
                        <p class="cert-date">Issued: 2024</p>
                        <div class="cert-links">
                            <a href="/files/github.pdf" class="cert-link" target="_blank">
                                <span>View PDF</span>
                                <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7zM19 19H5V5h7V3H5c-1.11 0-2 .89-2 2v14c0 1.11.89 2 2 2h14c1.11 0 2-.89 2-2v-7h-2v7z"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .section-header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 4rem;
    }

    .section-number {
        font-family: 'JetBrains Mono', monospace;
        font-size: 1.5rem;
        color: #00f7ff;
        font-weight: 600;
    }

    .section-title {
        font-size: 3rem;
        font-weight: 700;
        color: #ffffff;
        margin: 0;
    }

    .certificates-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 2.5rem;
    }

    .cert-card {
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        overflow: hidden;
        backdrop-filter: blur(20px);
        transition: all 0.4s cubic-bezier(0.23, 1, 0.32, 1);
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .cert-card:hover {
        transform: translateY(-10px);
        border-color: rgba(0, 247, 255, 0.3);
        box-shadow: 0 20px 40px rgba(0, 247, 255, 0.1);
    }

    .cert-image-container {
        position: relative;
        width: 100%;
        height: 200px;
        overflow: hidden;
        background: rgba(0, 0, 0, 0.3);
    }

    .cert-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }

    .cert-card:hover .cert-image {
        transform: scale(1.1);
    }

    .cert-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 247, 255, 0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: all 0.3s ease;
    }

    .cert-card:hover .cert-overlay {
        opacity: 1;
    }

    .cert-icon {
        width: 50px;
        height: 50px;
        background: #00f7ff;
        color: #000;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        transform: translateY(20px);
        transition: all 0.3s ease;
    }

    .cert-card:hover .cert-icon {
        transform: translateY(0);
    }

    .cert-card-info {
        padding: 2rem;
        flex-grow: 1;
        display: flex;
        flex-direction: column;
    }

    .cert-content {
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .cert-title {
        font-size: 1.3rem;
        font-weight: 700;
        color: #ffffff;
        margin: 0 0 0.75rem 0;
        line-height: 1.4;
    }

    .cert-issuer {
        color: #00f7ff;
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.9rem;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }

    .cert-date {
        color: #888888;
        font-size: 0.85rem;
        margin-bottom: 2rem;
    }

    .cert-links {
        margin-top: auto;
    }

    .cert-link {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        color: #ffffff;
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 600;
        padding: 0.75rem 1.25rem;
        background: rgba(0, 247, 255, 0.1);
        border: 1px solid rgba(0, 247, 255, 0.2);
        border-radius: 8px;
        transition: all 0.3s ease;
        width: 100%;
        justify-content: center;
    }

    .cert-link:hover {
        background: #00f7ff;
        color: #000000;
        box-shadow: 0 0 20px rgba(0, 247, 255, 0.3);
    }

    @media (max-width: 768px) {
        .section-title {
            font-size: 2.5rem;
        }
        
        .certificates-grid {
            grid-template-columns: 1fr;
        }
    }
</style>
